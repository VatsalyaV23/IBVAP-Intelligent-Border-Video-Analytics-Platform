# IBVAP Backend Render Environment Variables Configuration
# Set these variables in Render Service Dashboard -> Environment

# Service Port (Automatically injected by Render, default 8000 for local)
PORT=8000

# Allowed CORS Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGINS=https://ibvap-intelligent-border-anal.vercel.app,http://localhost:5173
FRONTEND_URL=https://ibvap-intelligent-border-anal.vercel.app

# Environment Mode
APP_ENV=production
DEBUG=False

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./ibvap.db

# Storage Directories
STORAGE_DIR=./storage
EVIDENCE_DIR=./storage/evidence

# Security Settings
JWT_SECRET=ibvap_border_surveillance_c4isr_secret_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Pipeline Configuration
AI_DEVICE=cpu
CONFIDENCE_THRESHOLD=0.50
PRIVACY_MODE=True

# Blockchain Settings
BLOCKCHAIN_MODE=LOCAL_LEDGER
