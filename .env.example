# IBVAP Environment Configuration
PROJECT_NAME="IBVAP - Intelligent Border Video Analytics Platform"
APP_ENV="development"
DEBUG=True

# Database (Default local SQLite for zero-config; supports postgresql+asyncpg://...)
DATABASE_URL="sqlite+aiosqlite:///./ibvap.db"

# Storage
STORAGE_DIR="./storage"
EVIDENCE_DIR="./storage/evidence"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

# Security & Authentication
JWT_SECRET="ibvap_border_surveillance_c4isr_secret_key_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Configuration
AI_DEVICE="auto"
CONFIDENCE_THRESHOLD=0.5
DETECTION_INTERVAL=1
FACE_MATCHING_ENABLED=False
PRIVACY_MODE=True

# Blockchain Settings
BLOCKCHAIN_MODE="LOCAL_LEDGER"
BLOCKCHAIN_ENDPOINT=""
FABRIC_PEER_ENDPOINT=""

# Camera & Streaming
RTSP_TIMEOUT=5
DEFAULT_RETENTION_DAYS=90
EVIDENCE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
